<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerVertical="true"
    android:orientation="vertical"
    tools:context="com.example.pphiepi.pphipfp.DownloadDataFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >


        <Button
            android:text="Download Config"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:id="@+id/btnDownloadConfig"
            android:background="@drawable/roundblue"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_marginLeft="75dp"
            android:layout_marginRight="75dp"
            android:layout_marginTop="5dp"
            android:paddingTop="10dp"
            android:drawableLeft="@drawable/upload" />

        <Button
            android:text="Show Detail"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:id="@+id/btnGeneratevisitfile"
            android:background="@drawable/roundblue"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_marginLeft="75dp"
            android:layout_marginRight="75dp"
            android:layout_marginTop="5dp"
            android:paddingTop="10dp"
            android:visibility="gone"
            android:drawableLeft="@drawable/upload" />



    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="200dp"
                android:gravity="center_horizontal"
                >

                <TextView
                    android:text="Message"
                    android:id="@+id/tvMsg"
                    android:textColor="@color/colorPink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

    </ScrollView>



</LinearLayout>
