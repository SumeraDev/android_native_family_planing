<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.pphiepi.pphipfp.PincodeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:textColor="@color/lightPink"
            android:drawableTop="@drawable/lockblack"
            android:textSize="20dp"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"

        android:gravity="center_horizontal">

        <EditText
            android:id="@+id/etPincode"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            android:inputType="numberPassword"
            android:hint="ENTER PINCODE"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"

        android:gravity="center_horizontal">


        <Button
            android:id="@+id/btnLogin"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:background="@drawable/roundblue"
            android:text="Login"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:paddingTop="10dp"
            android:drawableLeft="@drawable/loginnn"/>
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:paddingTop="10dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/roundpink"
            android:drawableRight="@drawable/crosss"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"

        android:gravity="center_horizontal">

        <TextView
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            android:text="Alert"
            android:textColor="#F44336"
            android:id="@+id/tvMsg"/>

    </LinearLayout>
</LinearLayout>
