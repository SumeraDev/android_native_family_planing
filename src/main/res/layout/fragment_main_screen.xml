<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerVertical="true"
    android:orientation="vertical"
    tools:context="com.example.pphiepi.pphipfp.MainScreenFragment">

    <!-- TODO: Update blank fragment layout -->

    <TextView
        android:id="@+id/tvQuarter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quarter:"
        android:textAlignment="center"
        android:background="@color/colorbluetwo"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_height="120dp"
        android:background="@drawable/pphilogo"
        android:layout_marginTop="20dp"
        ></ImageView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"

        android:gravity="center_horizontal|center_vertical"
        >

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="385dp"
            android:layout_height="60dp"

            android:layout_gravity="center"
            android:textColor="@color/white"
            android:gravity="center_horizontal|center_vertical"
            android:background="@drawable/roundblue"
            android:textStyle="bold"
            android:textSize="17dp"
            android:text=""/>



    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"

        android:gravity="center_horizontal|center_vertical"
        >



        <TextView
            android:id="@+id/tvTotalUploaded"
            android:layout_width="190dp"
            android:layout_height="60dp"

            android:layout_gravity="center"
            android:textColor="@color/white"
            android:gravity="center_horizontal|center_vertical"
            android:background="@drawable/roundblue"
            android:textStyle="bold"

            android:text=""
            android:textSize="17dp"
            />
        <TextView
            android:id="@+id/tvTotalPending"
            android:layout_width="190dp"
            android:layout_height="60dp"
            android:layout_marginLeft="5dp"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:gravity="center_horizontal|center_vertical"
            android:background="@drawable/roundpink"
            android:textStyle="bold"
            android:textSize="17dp"
            android:text=""/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        >

        <Button
            android:text="Config Data"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:id="@+id/btnDownload"
            android:background="@drawable/roundborder"
            android:textStyle="bold"
            android:textColor="@color/green2"
            android:textSize="19dp"
            android:paddingTop="10dp"
            android:drawableTop="@drawable/setting" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/roundborder"
            android:drawableTop="@drawable/locationpin"
            android:paddingTop="10dp"
            android:text="Visit Setup"
            android:textColor="@color/green2"
            android:textSize="19dp"
            android:textStyle="bold"

            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >

        <Button
            android:id="@+id/btncompletesetup"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:paddingTop="10dp"

            android:background="@drawable/roundborder"
            android:drawableTop="@drawable/test"

            android:text="Register Visit"
            android:textColor="@color/green2"
            android:textSize="19dp"
            android:textStyle="bold"

            />

        <Button
            android:id="@+id/btnUpload"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/roundborder"
            android:drawableTop="@drawable/uploadd"
            android:paddingTop="10dp"
            android:text="Upload Data"
            android:textColor="@color/green2"
            android:textSize="19dp"
            android:textStyle="bold"

            />


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >
        <Button
            android:text="View\nVisits"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:visibility="gone"
            android:id="@+id/btnViewVisit"
            android:background="@drawable/round"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"
            android:textColor="@color/greenlight"
            android:textSize="20dp"
            android:paddingTop="10dp"
            android:drawableTop="@drawable/search"

            />
        <Button
            android:text="Activate\nVisit"
            android:layout_width="159dp"
            android:layout_height="123dp"
            android:visibility="gone"
            android:id="@+id/btnActivatevisit"
            android:background="@drawable/roundpink"
            android:textStyle="bold"
            android:textColor="@color/greenlight"
            android:textSize="20dp"
            android:paddingTop="10dp"
            android:drawableTop="@drawable/register"

            />




    </LinearLayout>


</LinearLayout>
