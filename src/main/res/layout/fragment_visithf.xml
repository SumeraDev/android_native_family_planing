<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.pphiepi.pphipfp.VisithfFragment">

    <android.support.v7.widget.AppCompatSpinner
        android:id="@+id/ddlDistricts"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:headerDividersEnabled="true"
        android:footerDividersEnabled="true">

    </android.support.v7.widget.AppCompatSpinner>
    <android.support.v7.widget.AppCompatSpinner
        android:id="@+id/ddlHealthFacilities"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:headerDividersEnabled="true"
        android:footerDividersEnabled="true">

    </android.support.v7.widget.AppCompatSpinner>


    <android.support.v7.widget.AppCompatSpinner
        android:id="@+id/ddlEmployees"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:headerDividersEnabled="true"
        android:footerDividersEnabled="true">

    </android.support.v7.widget.AppCompatSpinner>

    <android.support.design.widget.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp">
        <EditText
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="10dp"
            android:layout_centerVertical="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:ems="10"
            android:id="@+id/etVisitDate"/>
    </android.support.design.widget.TextInputLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"

        android:gravity="center_horizontal">


        <Button
            android:id="@+id/btnNext"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:background="@drawable/roundblue"
            android:text="Next"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:drawableRight="@drawable/ff"
            android:paddingTop="10dp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="147dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textSize="20dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/roundpink"
            android:textColor="@color/white"
            android:drawableRight="@drawable/crosss"
            android:paddingTop="10dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"

        android:gravity="center_horizontal">

        <TextView
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            android:text="Alert"
            android:textSize="25dp"
            android:textColor="#F44336"
            android:id="@+id/tvMsg"/>

    </LinearLayout>



</LinearLayout>
