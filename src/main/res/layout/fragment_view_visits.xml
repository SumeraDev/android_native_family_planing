<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.pphiepi.pphipfp.ViewVisitsFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >
    <TextView
        android:id="@+id/tvCountMasterVisits"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="30dp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center_horizontal|center_vertical"
        android:background="@drawable/roundblue"
        android:textStyle="bold"
        android:text=""
        android:textSize="30dp"
        />
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >
        <TextView
            android:id="@+id/tvCountMasterVisitsUnupload"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="0dp"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:gravity="center_horizontal|center_vertical"
            android:background="@drawable/roundpurple"
            android:textStyle="bold"
            android:text=""
            android:textSize="30dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        >

    <TextView
        android:id="@+id/tvCountAns"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center_horizontal|center_vertical"
        android:background="@drawable/roundpink"
        android:textStyle="bold"
        android:textSize="30dp"
        android:text=""/>

    <TextView
        android:id="@+id/tvViewAttendance"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:gravity="center_horizontal|center_vertical"
        android:background="@drawable/round"
        android:textStyle="bold"
        android:layout_marginLeft="20dp"
        android:text=""
        android:textSize="30dp"
        />

        </LinearLayout>
</LinearLayout>
